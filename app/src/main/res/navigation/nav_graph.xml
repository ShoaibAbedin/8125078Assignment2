<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.s8125078.assignment2.ui.login.LoginFragment"
        android:label="@string/login_screen_label"
        tools:layout="@layout/fragment_login">

        <!-- popUpTo login so Back on the dashboard closes the app -->
        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.s8125078.assignment2.ui.dashboard.DashboardFragment"
        android:label="@string/dashboard_screen_label"
        tools:layout="@layout/fragment_dashboard">

        <argument
            android:name="keypass"
            app:argType="string" />
    </fragment>

</navigation>
