<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Chronicle" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/chronicle_amber</item>
        <item name="colorOnPrimary">@color/chronicle_on_amber</item>
        <item name="colorPrimaryContainer">@color/chronicle_amber_container</item>
        <item name="colorOnPrimaryContainer">@color/chronicle_on_amber_container</item>
        <item name="colorSecondary">@color/chronicle_amber_accent</item>
        <item name="colorSurface">@color/chronicle_surface</item>
        <item name="colorOnSurface">@color/chronicle_ink</item>
        <item name="colorOnSurfaceVariant">@color/chronicle_ink_muted</item>
        <item name="colorOutline">@color/chronicle_outline</item>
        <item name="colorOutlineVariant">@color/chronicle_divider</item>
        <item name="colorError">@color/chronicle_error</item>
        <item name="android:colorBackground">@color/chronicle_parchment</item>
        <item name="colorOnBackground">@color/chronicle_ink</item>

        <item name="materialButtonStyle">@style/Widget.Chronicle.Button</item>
        <item name="textInputStyle">@style/Widget.Chronicle.TextInputLayout</item>

        <!-- dark status bar icons on the light background -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- keep the light look even in dark mode -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.Chronicle" parent="Base.Theme.Chronicle" />

</resources>
