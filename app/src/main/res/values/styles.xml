<?xml version="1.0" encoding="utf-8"?>
<!-- Serif for headings, default font for everything else -->
<resources>

    <style name="TextAppearance.Chronicle.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">serif</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/chronicle_on_amber_container</item>
        <item name="android:textSize">40sp</item>
    </style>

    <style name="TextAppearance.Chronicle.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">serif</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/chronicle_heading</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextAppearance.Chronicle.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/chronicle_ink</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="TextAppearance.Chronicle.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/chronicle_ink_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Chronicle.Reading" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">serif</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/chronicle_ink</item>
        <item name="android:textSize">17sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="TextAppearance.Chronicle.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/chronicle_ink_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.Chronicle.Period" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/chronicle_amber</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.Chronicle.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/button_corner</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.Chronicle.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/chronicle_surface</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_field</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_field</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_field</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_field</item>
    </style>

</resources>
